{
  "appId": "com.ghjeong.pepe-terminal-ssh",
  "productName": "PePe Terminal(SSH)",
  "afterPack": "./scripts/strip-publishername.cjs",
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "extraMetadata": {
    "name": "PePe Terminal(SSH)"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "HyungdukSeo",
      "repo": "pepe-terminal-ssh"
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/node-pty/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/x11-server.zip",
      "to": "x11-server.zip"
    },
    {
      "from": "resources/x11-server/README.txt",
      "to": "x11-server/README.txt"
    },
    {
      "from": "docs",
      "to": "docs",
      "filter": [
        "RELEASE_v*.md"
      ]
    },
    {
      "from": "resources/i18n",
      "to": "i18n",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/jdbc-sidecar",
      "to": "jdbc-sidecar",
      "filter": [
        "*.jar"
      ]
    },
    {
      "from": "resources/jdbc-drivers/bundled",
      "to": "jdbc-drivers/bundled",
      "filter": [
        "*.jar"
      ]
    },
    {
      "from": "resources/rg",
      "to": "rg",
      "filter": [
        "**/*"
      ]
    }
  ],
  "asarUnpack": [
    "dist-electron/mcpSshServer.cjs",
    "**/node_modules/node-pty/**",
    "**/*.node"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "public/icon.ico",
    "cscLink": "cert/PePeTerminal_v2.pfx",
    "cscKeyPassword": "pepe1234",
    "extraResources": [
      {
        "from": "resources/openvpn-win",
        "to": "openvpn",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/jre/win-x64",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "include": "build/installer.nsh",
    "shortcutName": "PePe Terminal(SSH)",
    "artifactName": "PePe-Terminal-SSH-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "PePe-Terminal-SSH-${version}-portable.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    ],
    "icon": "public/icon-mac.png",
    "category": "public.app-category.developer-tools",
    "extraResources": [
      {
        "from": "resources/openvpn-mac",
        "to": "openvpn",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/jre/mac-${arch}",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      }
    ],
    "identity": null,
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
